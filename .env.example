# ── ElectionChain environment ─────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Server
NODE_ENV=development
PORT=4000

# Database (MongoDB Atlas free tier works)
MONGODB_URI=mongodb://localhost:27017/electionchain

# Auth — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_64_char_hex

# Admin wallet address (40 hex chars). Login with role=admin from this address.
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000

# ── Blockchain (optional — omit for DB-only mode) ─────────────────
# Deploy the contract first:  node deploy.js
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
# SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
# GANACHE_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=YOUR_CONTRACT_ADDRESS_AFTER_DEPLOY
ADMIN_PRIVATE_KEY=YOUR_PRIVATE_KEY

# ── Frontend / CORS ───────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Same-origin deployment (backend serves demo.html) needs nothing extra.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_MAX=100

# ── Email OTP (optional — omit to print OTPs to server console) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=your_email@gmail.com

# ── Admin result approval ─────────────────────────────────────────
REQUIRED_APPROVALS=1
